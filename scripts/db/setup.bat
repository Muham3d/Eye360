@echo off
REM################################################################################
REM PatrolManager Database Setup Script (Windows Batch)
REM
REM This script initializes the PostgreSQL database for development.
REM It starts Docker containers, runs migrations, and seeds initial data.
REM
REM Usage:
REM   scripts\db\setup.bat [options]
REM
REM Options:
REM   /f         Re-create database from scratch (WARNING: deletes all data)
REM   /s         Skip running seeders
REM   /?         Show this help message
REM################################################################################

setlocal EnableDelayedExpansion

REM Parse command line arguments
set FORCE_RECREATE=0
set SKIP_SEED=0

:parse_args
if "%~1"=="" goto end_parse_args
if /i "%~1"=="/f" set FORCE_RECREATE=1
if /i "%~1"=="/s" set SKIP_SEASEED=1
if /i "%~1"=="/?" goto show_help
shift
goto parse_args
:end_parse_args

REM Show help
if "%~1"=="/?" goto show_help

REM Get script directory
set SCRIPT_DIR=%~dp0
set PROJECT_ROOT=%SCRIPT_DIR%..\..\

REM Change to project root
cd /d "%PROJECT_ROOT%"

REM Print header
echo ================================================================
echo   PatrolManager Database Setup
echo ================================================================
echo.

REM Check if Docker is installed
echo [1/6] Checking Docker installation...
docker --version >nul 2>&1
if errorlevel 1 (
    echo Error: Docker is not installed or not running
    echo Please install Docker Desktop before running this script
    pause
    exit /b 1
)
echo Docker found
echo.

REM Check .env file
echo [2/6] Checking environment configuration...
if not exist ".env" (
    echo Warning: .env file not found
    echo Creating .env file with default values...

    REM Generate .env file
    (
        echo # PatrolManager Environment Configuration
        echo # Generated by database setup script
        echo.
        echo # Node Environment
        echo NODE_ENV=development
        echo.
        echo # Server Configuration
        echo PORT=3000
        echo SERVER_HOST=0.0.0.0
        echo API_URL=http://localhost:3000
        echo.
        echo # Database Configuration
        echo DB_HOST=localhost
        echo DB_PORT=5432
        echo DB_NAME=patrolmanager
        echo DB_USER=patrolmanager
        echo DB_PASSWORD=patrolmanager_dev_password
        echo DB_SSL=false
        echo DB_POOL_MAX=20
        echo DB_POOL_MIN=2
        echo DB_POOL_ACQUIRE=10000
        echo DB_POOL_IDLE=10000
        echo.
        echo # JWT Configuration
        echo JWT_SECRET=change_this_jwt_secret_in_production
        echo JWT_EXPIRES_IN=1h
        echo JWT_REFRESH_EXPIRES_IN=7d
        echo JWT_ISSUER=patrolmanager
        echo JWT_AUDIENCE=patrolmanager-api
        echo.
        echo # Session Configuration
        echo SESSION_SECRET=change_this_session_secret_in_production
        echo SESSION_COOKIE_MAX_AGE=86400000
        echo.
        echo # CORS Configuration
        echo CORS_ORIGIN=http://localhost:3000,http://localhost:5173
        echo.
        echo # Rate Limiting
        echo RATE_LIMIT_WINDOW_MS=900000
        echo RATE_LIMIT_MAX=1000
        echo.
        echo # Logging
        echo LOG_LEVEL=debug
        echo LOG_FORMAT=json
        echo LOG_FILE_PATH=./logs
        echo.
        echo # PgAdmin Configuration
        echo PGADMIN_EMAIL=admin@patrolmanager.local
        echo PGADMIN_PASSWORD=pgadmin_password
        echo PGADMIN_PORT=5050
    ) > .env

    echo .env file created
) else (
    echo .env file found
)
echo.

REM Stop existing containers if force recreate
if %FORCE_RECREATE%==1 (
    echo [3/6] Stopping existing containers...
    docker compose --file docker-compose.yml --profile admin down -v
    echo Containers stopped
) else (
    echo [3/6] Checking container status...
)
echo.

REM Start PostgreSQL container
echo [4/6] Starting PostgreSQL container...
docker compose --file docker-compose.yml up -d postgres
if errorlevel 1 (
    echo Error: Failed to start PostgreSQL container
    pause
    exit /b 1
)

REM Wait for PostgreSQL to be healthy
echo Waiting for PostgreSQL to be ready...
set /a RETRY_COUNT=0
set MAX_RETRIES=30

:wait_loop
if %RETRY_COUNT% geq %MAX_RETRIES% goto timeout_error
docker exec patrolmanager-postgres pg_isready -U patrolmanager -d patrolmanager >nul 2>&1
if errorlevel 1 (
    set /a RETRY_COUNT+=1
    echo Waiting... (!RETRY_COUNT!/!MAX_RETRIES!)
    timeout /t 2 /nobreak >nul
    goto wait_loop
)
echo PostgreSQL is ready
goto continue

:timeout_error
echo Error: PostgreSQL failed to start
pause
exit /b 1

:continue
echo.

REM Install dependencies if needed
echo [5/6] Checking backend dependencies...
if not exist "backend\node_modules" (
    echo Installing backend dependencies...
    cd backend
    call npm install
    cd ..
    echo Dependencies installed
) else (
    echo Dependencies already installed
)
echo.

REM Run database migrations
echo [6/6] Running database migrations...
cd backend
if %FORCE_RECREATE%==1 (
    echo Resetting database ^(dropping all tables^)...
    call npx sequelize-cli db:drop 2>nul
    call npx sequelize-cli db:create
)
call npx sequelize-cli db:migrate
if errorlevel 1 (
    echo Error: Migrations failed
    cd ..
    pause
    exit /b 1
)
echo Migrations completed
echo.

REM Run seeders
if %SKIP_SEED%==0 (
    echo [7/7] Running database seeders...
    call npx sequelize-cli db:seed:all
    echo Seeders completed
) else (
    echo [7/7] Skipping seeders
)
echo.

cd ..

REM Final summary
echo ================================================================
echo   Database Setup Complete!
echo ================================================================
echo.
echo Database connection details:
echo   Host: localhost
echo   Port: 5432
echo   Database: patrolmanager
echo   User: patrolmanager
echo.
echo Development users ^(password: TestPassword123!^):
echo   - admin@patrolmanager.local ^(Admin^)
echo   - manager@patrolmanager.local ^(Manager^)
echo   - supervisor@patrolmanager.local ^(Supervisor^)
echo   - guard@patrolmanager.local ^(Guard^)
echo.
echo To start the backend server:
echo   cd backend ^&^& npm run dev
echo.
echo To access PgAdmin ^(if enabled^):
echo   URL: http://localhost:5050
echo   Email: admin@patrolmanager.local
echo   Password: pgadmin_password
echo.
echo Note: Don't forget to update the JWT_SECRET and SESSION_SECRET in .env for production!
echo.
goto end

:show_help
echo Usage: scripts\db\setup.bat [options]
echo.
echo Options:
echo   /f         Re-create database from scratch ^(WARNING: deletes all data^)
echo   /s         Skip running seeders
echo   /?         Show this help message
echo.

:end
pause
