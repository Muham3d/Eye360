{
  "name": "patrol-manager",
  "version": "1.0.0",
  "description": "Security guard management system with real-time tracking, incident reporting, and patrol coordination",
  "main": "src/index.js",
  "scripts": {
    "project:start": "node .orchestration/start-execution.js",
    "project:status": "node .orchestration/project-status.js",
    "project:fix": "node .orchestration/fix-gate.js",
    "gate:review": "bash .gates/gate-review.sh",
    "report:daily": "node .scripts/generate-daily-report.js",

    "development": "nodemon src/index.js",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",

    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",

    "test:geofence": "jest --testPathPattern=geofence",
    "test:socket": "jest --testPathPattern=socket",
    "test:sos": "jest --testPathPattern=sos",
    "test:stress": "jest --testPathPattern=stress --testTimeout=300000",
    "test:incident": "jest --testPathPattern=incident",
    "test:upload": "jest --testPathPattern=upload",
    "test:ptt": "jest --testPathPattern=ptt",
    "test:shift": "jest --testPathPattern=shift",
    "test:report": "jest --testPathPattern=report",
    "test:performance": "jest --testPathPattern=performance",
    "test:load": "artillery run tests/load/load-test.yml",
    "test:penetration": "npm run test && npm audit",

    "audit:security": "npm audit && eslint . --security",
    "audit:dependencies": "npm audit --production",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",

    "docs:generate": "swagger-jsdoc -d docs/swagger.yaml -o docs/swagger.json src/routes/*.js",
    "docs:serve": "swagger-ui-express-cli -s docs/swagger.json",

    "db:migrate": "cd backend && npx sequelize-cli db:migrate",
    "db:migrate:undo": "cd backend && npx sequelize-cli db:migrate:undo",
    "db:seed": "cd backend && npx sequelize-cli db:seed:all",
    "db:seed:undo": "cd backend && npx sequelize-cli db:seed:undo:all",
    "db:reset": "cd backend && npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "db:setup": "node scripts/db/setup-wrapper.js",
    "db:setup:force": "node scripts/db/setup-wrapper.js --force",
    "db:clean": "node scripts/db/reset-wrapper.js",
    "db:clean:yes": "node scripts/db/reset-wrapper.js --yes",

    "docker:up": "docker compose up -d",
    "docker:up:admin": "docker compose --profile admin up -d",
    "docker:up:redis": "docker compose --profile redis up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:logs:postgres": "docker compose logs -f postgres",
    "docker:build": "docker compose build",
    "docker:ps": "docker compose ps",

    "deploy:staging": "node .scripts/deploy.js --env=staging",
    "deploy:production": "node .scripts/deploy.js --env=production"
  },
  "keywords": [
    "security",
    "patrol",
    "guard-management",
    "real-time",
    "gps-tracking",
    "incident-reporting"
  ],
  "author": "PatrolManager Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/patrol-manager.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/patrol-manager/issues"
  },
  "homepage": "https://github.com/your-org/patrol-manager#readme",
  "dependencies": {
    "express": "^4.19.2",
    "sequelize": "^6.37.1",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "socket.io": "^4.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "express-session": "^1.18.0",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0",
    "joi": "^17.12.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1580.0",
    "sharp": "^0.33.2",
    "node-cron": "^3.0.3",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0",
    "ejs": "^3.1.9",
    "tailwindcss": "^3.4.1",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^2.1.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2",
    "artillery": "^2.0.6",
    "@types/jest": "^29.5.12"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:security/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "security/detect-object-injection": "warn"
    }
  }
}
