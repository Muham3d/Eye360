# =============================================================================
# PatrolManager Environment Configuration Template
# =============================================================================
#
# Copy this file to .env and fill in the actual values for your environment.
#
# SECURITY WARNING: Never commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
SERVER_HOST=0.0.0.0
API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patrolmanager
DB_USER=patrolmanager
DB_PASSWORD=change_this_password_in_production
DB_SSL=false
DB_URL=

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=10000
DB_POOL_EVICT=60000

# -----------------------------------------------------------------------------
# JWT Configuration (Mobile API Authentication)
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_jwt_secret_use_openssl_rand_hex_32_or_similar
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=patrolmanager
JWT_AUDIENCE=patrolmanager-api

# -----------------------------------------------------------------------------
# Session Configuration (Admin Web Panel)
# -----------------------------------------------------------------------------
SESSION_SECRET=change_this_session_secret_use_openssl_rand_hex_32_or_similar
SESSION_COOKIE_MAX_AGE=86400000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=./logs
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# -----------------------------------------------------------------------------
# PostgreSQL Admin (Optional - for PgAdmin container)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@patrolmanager.local
PGADMIN_PASSWORD=change_this_pgadmin_password
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching/Sessions)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# File Upload (S3 or Local Storage)
# -----------------------------------------------------------------------------
# For AWS S3:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=patrolmanager-uploads

# For local storage (no additional config needed)

# -----------------------------------------------------------------------------
# Socket.io Configuration
# -----------------------------------------------------------------------------
SOCKET_IO_PORT=3000
SOCKET_IO_PATH=/socket.io

# -----------------------------------------------------------------------------
# Geofencing & GPS Configuration
# -----------------------------------------------------------------------------
# GPS update interval in milliseconds
GPS_UPDATE_INTERVAL=5000
# Maximum allowed GPS deviation in meters
GPS_MAX_DEVIATION=100
# Geofence check interval in milliseconds
GEOFENCE_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Notification Configuration
# -----------------------------------------------------------------------------
# Push notification service (FCM, APNS, etc.)
PUSH_NOTIFICATION_SERVICE=
PUSH_NOTIFICATION_KEY=

# Email notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@patrolmanager.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@patrolmanager.com

# -----------------------------------------------------------------------------
# External Integrations
# -----------------------------------------------------------------------------
# Twilio for SMS/Two-factor authentication
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Map service (Google Maps, Mapbox, etc.)
MAPS_API_KEY=
MAPS_PROVIDER=google

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_ENABLE_PUSH_NOTIFICATIONS=true
FEATURE_ENABLE_EMAIL_NOTIFICATIONS=true
FEATURE_ENABLE_SMS_NOTIFICATIONS=false
FEATURE_ENABLE_INCIDENT_ESCALATION=true
FEATURE_ENABLE_PATROL_AUTO_ASSIGNMENT=false
