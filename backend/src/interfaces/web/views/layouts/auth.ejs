<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'PatrolManager Admin' %></title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/assets/css/dist.css">
  <%- blocks.head %>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    /* Animation utilities */
    .fade-in { animation: fadeIn 0.3s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  </style>
</head>
<body class="bg-secondary-50 text-secondary-900 min-h-screen">

  <!-- Flash Messages -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div id="flash-messages" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 max-w-md">
      <% if (flash.error) { %>
        <% const messages = Array.isArray(flash.error) ? flash.error : [flash.error]; %>
        <% messages.forEach(message => { %>
          <div class="bg-white border-l-4 border-error-500 text-secondary-800 px-4 py-3 rounded shadow-strong flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-error-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-sm">Error</p>
              <p class="text-sm mt-0.5 text-secondary-600"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-secondary-400 hover:text-secondary-600" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>
    </div>
  <% } %>

  <main role="main">
    <%- body %>
  </main>

  <%- blocks.scripts %>
  <script>
      setTimeout(() => {
        const flashContainer = document.getElementById('flash-messages');
        if (flashContainer) {
          const messages = flashContainer.children;
          for (let i = messages.length - 1; i >= 0; i--) {
            messages[i].style.opacity = '0';
            messages[i].style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => messages[i].remove(), 300);
          }
        }
      }, 5000);
  </script>
</body>
</html>
