<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PatrolManager Admin Portal - Manage security patrols, guards, and sites.">
  <meta name="theme-color" content="#2563eb">
  <title><%= typeof title !== 'undefined' ? title : 'PatrolManager Admin' %></title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/assets/css/dist.css">

  <style>
    /* Inline critical CSS */
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Focus visible styles for accessibility */
    *:focus-visible {
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }

    /* Skip to main content link for accessibility */
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: #2563eb;
      color: white;
      padding: 8px 16px;
      text-decoration: none;
      z-index: 100;
    }

    .skip-link:focus {
      top: 0;
    }

    /* Animation utilities */
    .fade-in {
      animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>

  <%- blocks.head %>
</head>
<body class="bg-secondary-50 text-secondary-900 min-h-screen flex overflow-hidden">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Flash Messages -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div id="flash-messages" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 max-w-md">
      <% if (flash.success) { %>
        <% const messages = Array.isArray(flash.success) ? flash.success : [flash.success]; %>
        <% messages.forEach(message => { %>
          <div class="bg-white border-l-4 border-success-500 text-secondary-800 px-4 py-3 rounded shadow-strong flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-success-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-sm">Success</p>
              <p class="text-sm mt-0.5 text-secondary-600"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-secondary-400 hover:text-secondary-600 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.error) { %>
        <% const messages = Array.isArray(flash.error) ? flash.error : [flash.error]; %>
        <% messages.forEach(message => { %>
          <div class="bg-white border-l-4 border-error-500 text-secondary-800 px-4 py-3 rounded shadow-strong flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-error-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-sm">Error</p>
              <p class="text-sm mt-0.5 text-secondary-600"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-secondary-400 hover:text-secondary-600 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.warning) { %>
        <% const messages = Array.isArray(flash.warning) ? flash.warning : [flash.warning]; %>
        <% messages.forEach(message => { %>
          <div class="bg-white border-l-4 border-warning-500 text-secondary-800 px-4 py-3 rounded shadow-strong flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-warning-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-sm">Warning</p>
              <p class="text-sm mt-0.5 text-secondary-600"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-secondary-400 hover:text-secondary-600 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.info) { %>
        <% const messages = Array.isArray(flash.info) ? flash.info : [flash.info]; %>
        <% messages.forEach(message => { %>
          <div class="bg-white border-l-4 border-info-500 text-secondary-800 px-4 py-3 rounded shadow-strong flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-info-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-semibold text-sm">Info</p>
              <p class="text-sm mt-0.5 text-secondary-600"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-secondary-400 hover:text-secondary-600 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Auto-dismiss flash messages after 5 seconds -->
    <script>
      setTimeout(() => {
        const flashContainer = document.getElementById('flash-messages');
        if (flashContainer) {
          const messages = flashContainer.children;
          for (let i = messages.length - 1; i >= 0; i--) {
            messages[i].style.opacity = '0';
            messages[i].style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => messages[i].remove(), 300);
          }
        }
      }, 5000);
    </script>
  <% } %>

  <!-- Navigation / Sidebar -->
  <%- include('../components/navigation', { currentUser, currentPath }) %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-secondary-50 transition-all duration-300">

    <!-- Top Header (Mobile & Desktop) -->
    <header class="bg-white border-b border-secondary-200 h-16 flex items-center justify-between px-4 sm:px-6 lg:px-8 z-10 shadow-sm">
      <div class="flex items-center">
        <!-- Mobile Sidebar Toggle -->
        <button type="button" class="lg:hidden text-secondary-500 hover:text-secondary-700 focus:outline-none p-2 mr-3" onclick="document.dispatchEvent(new CustomEvent('toggleSidebar'))">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <h1 class="text-xl font-semibold text-secondary-900 truncate"><%= typeof title !== 'undefined' ? title.split(' - ')[0] : 'Dashboard' %></h1>
      </div>

      <!-- Top Right User Menu -->
      <div class="flex items-center gap-4">
        <!-- Notifications -->
        <button type="button" class="relative p-2 text-secondary-400 hover:text-secondary-600 rounded-full hover:bg-secondary-100 transition-colors">
          <span class="sr-only">View notifications</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-error-500 rounded-full ring-2 ring-white"></span>
        </button>

        <!-- User Dropdown -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <div class="relative" id="header-user-menu-container">
            <button type="button" class="flex items-center gap-2 focus:outline-none" id="header-user-menu-button" aria-expanded="false" aria-haspopup="true" onclick="toggleHeaderUserMenu()">
              <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center text-white font-medium shadow-sm">
                <%= currentUser.firstName ? currentUser.firstName[0] : currentUser.email[0].toUpperCase() %>
              </div>
              <svg class="w-4 h-4 text-secondary-400 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown menu -->
            <div id="header-user-menu" class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-strong bg-white ring-1 ring-black ring-opacity-5 py-1 hidden z-50 focus:outline-none" role="menu" aria-orientation="vertical" aria-labelledby="header-user-menu-button">
              <div class="px-4 py-2 border-b border-secondary-100">
                <p class="text-sm font-medium text-secondary-900 truncate"><%= currentUser.firstName && currentUser.lastName ? currentUser.firstName + ' ' + currentUser.lastName : currentUser.email %></p>
                <p class="text-xs text-secondary-500 truncate"><%= currentUser.role || 'User' %></p>
              </div>
              <a href="/profile" class="block px-4 py-2 text-sm text-secondary-700 hover:bg-secondary-100" role="menuitem">Your Profile</a>
              <a href="/settings" class="block px-4 py-2 text-sm text-secondary-700 hover:bg-secondary-100" role="menuitem">Settings</a>
              <form action="/logout" method="POST" class="block">
                <button type="submit" class="w-full text-left px-4 py-2 text-sm text-error-600 hover:bg-error-50 font-medium" role="menuitem">Sign out</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </header>

    <!-- Main Scrollable Area -->
    <main id="main-content" class="flex-1 overflow-y-auto focus:outline-none relative" role="main" tabindex="-1">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-20 lg:pb-8">
        <%- body %>
      </div>
    </main>
  </div>

  <!-- Scripts -->
  <%- blocks.scripts %>

  <!-- Shared Layout Scripts -->
  <script>
    // Header user menu toggle
    function toggleHeaderUserMenu() {
      const menu = document.getElementById('header-user-menu');
      const button = document.getElementById('header-user-menu-button');
      if(menu && button) {
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
        }
      }
    }

    // Close header dropdown when clicking outside
    document.addEventListener('click', function(event) {
      const container = document.getElementById('header-user-menu-container');
      const menu = document.getElementById('header-user-menu');
      if (container && menu && !container.contains(event.target)) {
        menu.classList.add('hidden');
        const button = document.getElementById('header-user-menu-button');
        if (button) button.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        const menu = document.getElementById('header-user-menu');
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          const button = document.getElementById('header-user-menu-button');
          if (button) button.setAttribute('aria-expanded', 'false');
        }
      }
    });
  </script>
</body>
</html>
