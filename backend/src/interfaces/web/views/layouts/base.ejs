<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title><%= title || 'PatrolManager - Admin Panel' %></title>

  <meta name="description" content="<%= description || 'PatrolManager - Security guard management system with real-time tracking, incident reporting, and patrol coordination' %>">
  <meta name="author" content="PatrolManager Team">

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <% if (process.env.NODE_ENV === 'production') { %>
  <link rel="stylesheet" href="/assets/css/main.css">
  <% } else { %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
              950: '#172554',
            },
            secondary: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
              950: '#020617',
            },
            success: {
              500: '#22c55e',
              600: '#16a34a',
            },
            warning: {
              500: '#eab308',
              600: '#ca8a04',
            },
            error: {
              500: '#ef4444',
              600: '#dc2626',
            },
          },
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
            mono: ['JetBrains Mono', 'Monaco', 'Courier New', 'monospace'],
          },
        }
      }
    }
  </script>
  <% } %>

  <!-- Custom CSS -->
  <style>
    /* Base styles */
    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Focus visible styles for accessibility */
    *:focus-visible {
      outline: 2px solid #2563eb;
      outline-offset: 2px;
    }

    /* Skip to main content link for accessibility */
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: #2563eb;
      color: white;
      padding: 8px 16px;
      text-decoration: none;
      z-index: 100;
    }

    .skip-link:focus {
      top: 0;
    }

    /* Animation utilities */
    .fade-in {
      animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>

  <%- blocks.head %>
</head>
<body class="bg-secondary-50 text-secondary-900 min-h-screen flex flex-col">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Flash Messages -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div id="flash-messages" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-md">
      <% if (flash.success) { %>
        <% const messages = Array.isArray(flash.success) ? flash.success : [flash.success]; %>
        <% messages.forEach(message => { %>
          <div class="bg-success-50 border border-success-200 text-success-800 px-4 py-3 rounded-lg shadow-soft flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-medium">Success</p>
              <p class="text-sm mt-1"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-success-600 hover:text-success-800 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.error) { %>
        <% const messages = Array.isArray(flash.error) ? flash.error : [flash.error]; %>
        <% messages.forEach(message => { %>
          <div class="bg-error-50 border border-error-200 text-error-800 px-4 py-3 rounded-lg shadow-soft flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-medium">Error</p>
              <p class="text-sm mt-1"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-error-600 hover:text-error-800 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.warning) { %>
        <% const messages = Array.isArray(flash.warning) ? flash.warning : [flash.warning]; %>
        <% messages.forEach(message => { %>
          <div class="bg-warning-50 border border-warning-200 text-warning-800 px-4 py-3 rounded-lg shadow-soft flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-medium">Warning</p>
              <p class="text-sm mt-1"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-warning-600 hover:text-warning-800 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>

      <% if (flash.info) { %>
        <% const messages = Array.isArray(flash.info) ? flash.info : [flash.info]; %>
        <% messages.forEach(message => { %>
          <div class="bg-info-50 border border-info-200 text-info-800 px-4 py-3 rounded-lg shadow-soft flex items-start gap-3 fade-in" role="alert">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="font-medium">Info</p>
              <p class="text-sm mt-1"><%= message %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 text-info-600 hover:text-info-800 transition-colors" aria-label="Close">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Auto-dismiss flash messages after 5 seconds -->
    <script>
      setTimeout(() => {
        const flashContainer = document.getElementById('flash-messages');
        if (flashContainer) {
          const messages = flashContainer.children;
          for (let i = messages.length - 1; i >= 0; i--) {
            messages[i].style.opacity = '0';
            messages[i].style.transition = 'opacity 0.3s ease-out';
            setTimeout(() => messages[i].remove(), 300);
          }
        }
      }, 5000);
    </script>
  <% } %>

  <!-- Navigation -->
  <%- include('../components/navigation', { currentUser, currentPath }) %>

  <!-- Main Content -->
  <main id="main-content" class="flex-1" role="main">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-secondary-900 text-secondary-300 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-2">
          <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span class="font-semibold text-white">PatrolManager</span>
        </div>

        <p class="text-sm">
          &copy; <%= new Date().getFullYear() %> PatrolManager. All rights reserved.
        </p>

        <nav class="flex gap-6 text-sm" aria-label="Footer navigation">
          <a href="/about" class="hover:text-white transition-colors">About</a>
          <a href="/support" class="hover:text-white transition-colors">Support</a>
          <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms</a>
        </nav>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <%- blocks.scripts %>

  <!-- Auto-dismiss script -->
  <script>
    // Auto-dismiss flash messages
    document.addEventListener('DOMContentLoaded', function() {
      const flashContainer = document.getElementById('flash-messages');
      if (flashContainer) {
        const messages = flashContainer.querySelectorAll('[role="alert"]');
        messages.forEach((message, index) => {
          setTimeout(() => {
            message.style.opacity = '0';
            message.style.transform = 'translateX(100%)';
            message.style.transition = 'all 0.3s ease-out';
            setTimeout(() => message.remove(), 300);
          }, 5000 + (index * 500));
        });
      }
    });
  </script>
</body>
</html>
