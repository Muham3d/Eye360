<%
/**
 * Dashboard Index View
 *
 * Main dashboard for the PatrolManager admin panel
 *
 * @param {Object} stats - Dashboard statistics
 */
%>

<!-- Page Header -->
<div class="bg-white border-b border-secondary-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-secondary-900">Dashboard</h1>
        <p class="text-secondary-500 mt-1">Welcome back, <%= currentUser?.firstName || currentUser?.email || 'User' %>!</p>
      </div>
      <div class="flex items-center gap-3">
        <button type="button" class="btn btn-secondary">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Export Report
        </button>
        <button type="button" class="btn btn-primary">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Quick Add
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Dashboard Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Active Guards -->
    <div class="card">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-secondary-500">Active Guards</p>
            <p class="text-2xl font-bold text-secondary-900 mt-1"><%= stats?.activeGuards || 0 %></p>
            <p class="text-xs text-success-600 mt-1 flex items-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              +12% from yesterday
            </p>
          </div>
          <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Sites -->
    <div class="card">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-secondary-500">Active Sites</p>
            <p class="text-2xl font-bold text-secondary-900 mt-1"><%= stats?.activeSites || 0 %></p>
            <p class="text-xs text-secondary-500 mt-1">Across all regions</p>
          </div>
          <div class="w-12 h-12 bg-success-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Patrols Today -->
    <div class="card">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-secondary-500">Patrols Today</p>
            <p class="text-2xl font-bold text-secondary-900 mt-1"><%= stats?.patrolsToday || 0 %></p>
            <p class="text-xs text-success-600 mt-1 flex items-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              +8% from yesterday
            </p>
          </div>
          <div class="w-12 h-12 bg-warning-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-warning-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Open Incidents -->
    <div class="card">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-secondary-500">Open Incidents</p>
            <p class="text-2xl font-bold text-secondary-900 mt-1"><%= stats?.openIncidents || 0 %></p>
            <p class="text-xs text-error-600 mt-1 flex items-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              +2 new today
            </p>
          </div>
          <div class="w-12 h-12 bg-error-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-error-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions & Recent Activity -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Quick Actions -->
    <div class="card">
      <div class="card-header">
        <h2 class="text-lg font-semibold text-secondary-900">Quick Actions</h2>
      </div>
      <div class="card-body">
        <div class="space-y-2">
          <a href="/sites/new" class="flex items-center gap-3 p-3 rounded-lg hover:bg-secondary-50 transition-colors group">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-secondary-900">Add New Site</p>
              <p class="text-sm text-secondary-500">Create a new patrol site</p>
            </div>
          </a>
          <a href="/users/new" class="flex items-center gap-3 p-3 rounded-lg hover:bg-secondary-50 transition-colors group">
            <div class="w-10 h-10 bg-success-100 rounded-lg flex items-center justify-center group-hover:bg-success-200 transition-colors">
              <svg class="w-5 h-5 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-secondary-900">Add Guard</p>
              <p class="text-sm text-secondary-500">Register a new guard</p>
            </div>
          </a>
          <a href="/patrols/new" class="flex items-center gap-3 p-3 rounded-lg hover:bg-secondary-50 transition-colors group">
            <div class="w-10 h-10 bg-warning-100 rounded-lg flex items-center justify-center group-hover:bg-warning-200 transition-colors">
              <svg class="w-5 h-5 text-warning-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-secondary-900">Create Patrol</p>
              <p class="text-sm text-secondary-500">Schedule a new patrol</p>
            </div>
          </a>
          <a href="/incidents/new" class="flex items-center gap-3 p-3 rounded-lg hover:bg-secondary-50 transition-colors group">
            <div class="w-10 h-10 bg-error-100 rounded-lg flex items-center justify-center group-hover:bg-error-200 transition-colors">
              <svg class="w-5 h-5 text-error-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-secondary-900">Report Incident</p>
              <p class="text-sm text-secondary-500">Log a new incident</p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="card lg:col-span-2">
      <div class="card-header flex items-center justify-between">
        <h2 class="text-lg font-semibold text-secondary-900">Recent Activity</h2>
        <a href="/activity" class="text-sm text-primary-600 hover:text-primary-700 font-medium">View all</a>
      </div>
      <div class="card-body">
        <% if (stats?.recentActivity && stats.recentActivity.length > 0) { %>
          <div class="space-y-4">
            <% stats.recentActivity.forEach((activity, index) => { %>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full <%= activity.colorClass || 'bg-primary-100' %> flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 <%= activity.iconColor || 'text-primary-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <%- activity.icon || '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>' %>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-secondary-900"><%= activity.title %></p>
                  <p class="text-sm text-secondary-500 truncate"><%= activity.description %></p>
                </div>
                <time class="text-xs text-secondary-400 whitespace-nowrap"><%= activity.time %></time>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-icon">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="empty-state-title">No Recent Activity</h3>
            <p class="empty-state-description">Your team's activity will appear here once patrol runs and incidents are logged.</p>
            <a href="/patrols/new" class="btn btn-primary mt-2">Schedule a Patrol</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% blocks.scripts = `
<script>
  // Add any dashboard-specific scripts here
</script>
`; %>
