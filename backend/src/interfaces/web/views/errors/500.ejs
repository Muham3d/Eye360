<%
/**
 * 500 Internal Server Error Page
 *
 * Displayed when an unexpected server error occurs
 *
 * @param {string} title - Page title
 * @param {string} message - Error message
 */
%>

<!-- Page Header -->
<div class="min-h-[500px] flex items-center justify-center bg-secondary-50 py-12 px-4">
  <div class="max-w-md w-full">
    <div class="card text-center">
      <!-- Error Icon -->
      <div class="mb-6">
        <svg class="w-24 h-24 mx-auto text-red-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>

      <!-- Error Message -->
      <h1 class="text-6xl font-bold text-secondary-900 mb-2">500</h1>
      <h2 class="text-2xl font-semibold text-secondary-800 mb-4">Server Error</h2>

      <p class="text-secondary-600 mb-8">
        <%= typeof message !== 'undefined' ? message : 'Something went wrong on our end. Our team has been notified.' %>
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <button onclick="window.location.reload()" class="btn btn-primary w-full sm:w-auto justify-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Try Again
        </button>
        <a href="/" class="btn btn-secondary w-full sm:w-auto justify-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/>
          </svg>
          Dashboard
        </a>
      </div>

      <!-- Helpful Tips -->
      <div class="mt-8 pt-8 border-t border-secondary-200">
        <h3 class="text-sm font-semibold text-secondary-700 mb-3">What can you do?</h3>
        <ul class="text-sm text-secondary-600 space-y-2 text-left">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-secondary-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 1 1 0 002zm0 0a1 1 0 102 1 1 0 01-2z" clip-rule="evenodd"/>
            </svg>
            Refresh the page in a few moments
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-secondary-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 1 1 0 002zm0 0a1 1 0 102 1 1 0 01-2z" clip-rule="evenodd"/>
            </svg>
            Go back to the dashboard and try again
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-secondary-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 1 1 0 002zm0 0a1 1 0 102 1 1 0 01-2z" clip-rule="evenodd"/>
            </svg>
            Contact your administrator if the problem persists
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
