<%
/**
 * 403 Forbidden Error Page
 *
 * Displayed when user lacks permission to access a resource
 *
 * @param {Object} error - Error details if available
 * @param {string} title - Page title
 */
%>

<!-- Page Header -->
<div class="min-h-[500px] flex items-center justify-center bg-secondary-50 py-12 px-4">
  <div class="max-w-md w-full">
    <div class="card text-center">
      <!-- Error Icon -->
      <div class="mb-6">
        <svg class="w-24 h-24 mx-auto text-error-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0A3.736 3.736 0 0013 3c0 1.84-.925 3.626-2.384 4.681a3.736 3.736 0 002.563 1.732c0 1.54-.925 3.018-2.384 3.681a3.736 3.736 0 00-3.464 0A3.736 3.736 0 002 11.619c0 1.54.925 3.018 2.384 3.681a3.736 3.736 0 003.464 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>

      <!-- Error Message -->
      <h1 class="text-6xl font-bold text-error-900 mb-2">403</h1>
      <h2 class="text-2xl font-semibold text-error-800 mb-4">Access Denied</h2>

      <p class="text-secondary-600 mb-8">
        <%= error?.message || 'You do not have permission to access this resource.' %>
      </p>

      <!-- Additional Context -->
      <div class="bg-error-50 border border-error-200 rounded-lg p-4 mb-8 text-left">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-error-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zm1-9a1 1 0 00-2 1v4a1 1 0 102 2v4a1 1 0 001-1h7a1 1 0 001-1v-4a1 1 0 00-1-1h-2a1 1 0 00-1 1v4a1 1 0 001 1h2a1 1 0 001-1v-4z" clip-rule="evenodd"/>
          </svg>
          <div class="text-sm text-error-700">
            <p class="font-medium">Why am I seeing this?</p>
            <p class="mt-1">This action requires special permissions that your account doesn't have. Please contact your administrator if you believe you should have access to this resource.</p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/users" class="btn btn-primary w-full sm:w-auto justify-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Users
        </a>
        <a href="/" class="btn btn-secondary w-full sm:w-auto justify-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7 7M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1v-3a1 1 0 011-1v-3a1 1 0 01-1-1H2a1 1 0 01-1 1v9a1 1 0 001 1z"/>
          </svg>
          Dashboard
        </a>
      </div>

      <!-- Role Permissions Info -->
      <div class="mt-8 pt-8 border-t border-secondary-200">
        <h3 class="text-sm font-semibold text-secondary-700 mb-3">Role Permissions</h3>
        <div class="grid grid-cols-2 gap-4 text-sm text-secondary-600">
          <div class="p-3 bg-white rounded border border-secondary-200">
            <div class="font-medium text-secondary-900 mb-1">Admin</div>
            <div class="text-xs">Full access, user management</div>
          </div>
          <div class="p-3 bg-white rounded border border-secondary-200">
            <div class="font-medium text-secondary-900 mb-1">Manager</div>
            <div class="text-xs">Sites, reports, supervision</div>
          </div>
          <div class="p-3 bg-white rounded border border-secondary-200">
            <div class="font-medium text-secondary-900 mb-1">Supervisor</div>
            <div class="text-xs">Patrol oversight, incidents</div>
          </div>
          <div class="p-3 bg-white rounded border border-secondary-200">
            <div class="font-medium text-secondary-900 mb-1">Guard</div>
            <div class="text-xs">Basic patrol access</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
