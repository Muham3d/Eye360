<%
/**
 * Delete User Confirmation Modal
 *
 * Modal for confirming user deletion
 *
 * @param {Object} user - User object to delete
 */
%>

<div class="modal-overlay" id="delete-user-modal" role="dialog" aria-modal="true" aria-labelledby="delete-user-title">
  <form method="POST" action="/users/<%= user.id %>/delete" class="modal-container">
    <div class="modal-header border-error-200">
      <h3 id="delete-user-title" class="modal-title text-error-600">Delete User</h3>
      <button type="button" class="p-2 text-secondary-500 hover:text-secondary-700 rounded-lg transition-colors" onclick="closeModal('delete-user-modal')" aria-label="Close modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <!-- Warning Banner -->
      <div class="flex items-start gap-3 p-4 bg-error-50 border border-error-200 rounded-lg mb-4">
        <svg class="w-6 h-6 text-error-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <div>
          <p class="font-medium text-error-900">Warning: This action cannot be undone!</p>
          <p class="text-sm text-error-700 mt-1">Once a user is deleted, all associated data will be permanently removed from the system.</p>
        </div>
      </div>

      <!-- User Info -->
      <div class="flex items-center gap-4 p-4 bg-secondary-50 rounded-lg mb-4">
        <div class="w-12 h-12 rounded-full bg-error-100 flex items-center justify-center flex-shrink-0">
          <span class="text-lg font-semibold text-error-600">
            <%= (user.firstName || user.email)[0].toUpperCase() %>
          </span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-medium text-secondary-900 truncate">
            <%= user.firstName ? user.firstName + ' ' + user.lastName : user.email %>
          </p>
          <p class="text-sm text-secondary-500 truncate"><%= user.email %></p>
        </div>
      </div>

      <!-- What will be deleted -->
      <div class="bg-secondary-50 rounded-lg p-4 mb-4">
        <p class="text-sm font-medium text-secondary-700 mb-3">The following data will be permanently deleted:</p>
        <ul class="space-y-2 text-sm text-secondary-600">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-error-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            User account and login credentials
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-error-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Profile information and settings
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-error-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Activity history and logs
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-error-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Associated patrol records
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-error-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            All assigned checkpoints and incidents
          </li>
        </ul>
      </div>

      <!-- Confirmation -->
      <div class="space-y-3">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="confirm"
            value="1"
            required
            class="w-5 h-5 mt-0.5 text-error-600 border-secondary-300 rounded focus:ring-error-500 focus:ring-offset-0">
          <span class="text-sm text-secondary-700">
            I understand that this action cannot be undone and all data associated with this user will be permanently deleted.
          </span>
        </label>

        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="confirm-delete"
            value="1"
            required
            class="w-5 h-5 mt-0.5 text-error-600 border-secondary-300 rounded focus:ring-error-500 focus:ring-offset-0">
          <span class="text-sm text-secondary-700">
            I want to delete <strong><%= user.email %></strong> from the system.
          </span>
        </label>
      </div>

      <!-- Type to confirm -->
      <div class="mt-4 space-y-2">
        <label for="confirm-text" class="input-label text-error-600">
          Type <strong>DELETE</strong> to confirm
        </label>
        <input
          type="text"
          id="confirm-text"
          name="confirm-text"
          class="input border-error-300 focus:border-error-500 focus:ring-error-500"
          pattern="DELETE"
          required
          placeholder="Type DELETE to confirm"
          oninput="checkConfirmText(this)">
        <p class="text-xs text-secondary-500">This is required to prevent accidental deletions.</p>
      </div>
    </div>
    <div class="modal-footer bg-error-50 border-error-200">
      <button type="button" class="btn btn-secondary" onclick="closeModal('delete-user-modal')">Cancel</button>
      <button type="submit" id="delete-button" class="btn btn-error" disabled>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Permanently Delete User
      </button>
    </div>
  </form>
</div>

<script>
  function checkConfirmText(input) {
    const deleteButton = document.getElementById('delete-button');
    if (input.value === 'DELETE') {
      deleteButton.disabled = false;
      deleteButton.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      deleteButton.disabled = true;
      deleteButton.classList.add('opacity-50', 'cursor-not-allowed');
    }
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.remove();
    }
  }

  // Close on escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeModal('delete-user-modal');
    }
  });

  // Close on backdrop click
  document.getElementById('delete-user-modal').addEventListener('click', function(event) {
    if (event.target === this) {
      closeModal('delete-user-modal');
    }
  });
</script>
