<%
/**
 * Change Status Modal
 *
 * Modal for changing a user's status
 *
 * @param {Object} user - User object
 */
%>

<div class="modal-overlay" id="change-status-modal" role="dialog" aria-modal="true" aria-labelledby="change-status-title">
  <form method="POST" action="/users/<%= user.id %>/status" class="modal-container">
    <div class="modal-header">
      <h3 id="change-status-title" class="modal-title">Change User Status</h3>
      <button type="button" class="p-2 text-secondary-500 hover:text-secondary-700 rounded-lg transition-colors" onclick="closeModal('change-status-modal')" aria-label="Close modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <!-- User Info -->
      <div class="flex items-center gap-4 p-4 bg-secondary-50 rounded-lg mb-4">
        <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
          <span class="text-lg font-semibold text-primary-600">
            <%= (user.firstName || user.email)[0].toUpperCase() %>
          </span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-medium text-secondary-900 truncate">
            <%= user.firstName ? user.firstName + ' ' + user.lastName : user.email %>
          </p>
          <p class="text-sm text-secondary-500 truncate"><%= user.email %></p>
        </div>
      </div>

      <!-- Current Status -->
      <div class="flex items-center justify-between p-3 bg-secondary-50 border border-secondary-200 rounded-lg mb-4">
        <span class="text-sm font-medium text-secondary-700">Current Status:</span>
        <% const statusConfig = {
          active: { color: 'bg-success-100 text-success-800', label: 'Active' },
          inactive: { color: 'bg-secondary-100 text-secondary-800', label: 'Inactive' },
          suspended: { color: 'bg-error-100 text-error-800', label: 'Suspended' },
          pending: { color: 'bg-warning-100 text-warning-800', label: 'Pending' }
        };
        const currentStatus = statusConfig[user.status?.toLowerCase()] || statusConfig.pending; %>
        <span class="badge <%= currentStatus.color %>">
          <%= currentStatus.label %>
        </span>
      </div>

      <!-- Status Selection -->
      <div class="space-y-3 mb-4">
        <label for="new-status" class="input-label">Select New Status</label>
        <select id="new-status" name="status" class="input" required onchange="updateStatusDescription()">
          <option value="">Select a status...</option>
          <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= user.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          <option value="suspended" <%= user.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
          <option value="pending" <%= user.status === 'pending' ? 'selected' : '' %>>Pending</option>
        </select>

        <!-- Dynamic Status Description -->
        <div id="status-description" class="text-sm text-secondary-600 bg-secondary-50 rounded-lg p-3 hidden">
          <p id="status-description-text"></p>
        </div>
      </div>

      <!-- Reason Textarea -->
      <div class="space-y-2">
        <label for="status-reason" class="input-label">Reason for Status Change</label>
        <textarea
          id="status-reason"
          name="reason"
          rows="3"
          class="input"
          placeholder="Provide a reason for this status change... (This will be logged in the user's history)"
          aria-describedby="reason-hint"></textarea>
        <p id="reason-hint" class="text-xs text-secondary-500">Optional but recommended for audit purposes</p>
      </div>

      <!-- Impact Warning -->
      <div class="mt-4 p-3 bg-warning-50 border border-warning-200 rounded-lg">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-warning-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <div class="text-sm text-warning-800">
            <p class="font-medium mb-1">Status Change Impact:</p>
            <ul class="space-y-1 text-warning-700">
              <li class="flex items-start gap-2">
                <span class="text-warning-500">•</span>
                <span><strong>Active:</strong> User can log in and access all permitted features</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-warning-500">•</span>
                <span><strong>Inactive:</strong> User cannot log in but data is preserved</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-warning-500">•</span>
                <span><strong>Suspended:</strong> User is temporarily locked out of the system</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-warning-500">•</span>
                <span><strong>Pending:</strong> Awaiting email verification or approval</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeModal('change-status-modal')">Cancel</button>
      <button type="submit" class="btn btn-primary">Change Status</button>
    </div>
  </form>
</div>

<script>
  const statusDescriptions = {
    active: 'The user will be able to log in and access all features granted by their role.',
    inactive: 'The user will not be able to log in. Their account and data will be preserved.',
    suspended: 'The user will be immediately locked out of the system and all active sessions will be terminated.',
    pending: 'The user must complete email verification before they can access the system.'
  };

  function updateStatusDescription() {
    const select = document.getElementById('new-status');
    const descriptionDiv = document.getElementById('status-description');
    const descriptionText = document.getElementById('status-description-text');
    const status = select.value;

    if (status && statusDescriptions[status]) {
      descriptionText.textContent = statusDescriptions[status];
      descriptionDiv.classList.remove('hidden');
    } else {
      descriptionDiv.classList.add('hidden');
    }
  }

  // Initialize description on page load
  updateStatusDescription();

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.remove();
    }
  }

  // Close on escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeModal('change-status-modal');
    }
  });

  // Close on backdrop click
  document.getElementById('change-status-modal').addEventListener('click', function(event) {
    if (event.target === this) {
      closeModal('change-status-modal');
    }
  });
</script>
