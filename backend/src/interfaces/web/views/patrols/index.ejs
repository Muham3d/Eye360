<div class="bg-white border-b border-secondary-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="text-2xl font-bold text-secondary-900">Patrol Runs</h1>
    <p class="text-secondary-500 mt-1">Monitor scheduled and active patrol executions</p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div class="card">
    <div class="card-body">
      <form method="GET" action="/patrols" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-3">
          <label class="input-label" for="search">Search</label>
          <input id="search" name="search" class="input" value="<%= filters?.search || '' %>" placeholder="Status, site name, or template">
        </div>
        <div>
          <label class="input-label" for="status">Status</label>
          <select id="status" name="status" class="input">
            <option value="">All</option>
            <option value="scheduled" <%= filters?.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
            <option value="in_progress" <%= filters?.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
            <option value="paused" <%= filters?.status === 'paused' ? 'selected' : '' %>>Paused</option>
            <option value="completed" <%= filters?.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="abandoned" <%= filters?.status === 'abandoned' ? 'selected' : '' %>>Abandoned</option>
            <option value="failed" <%= filters?.status === 'failed' ? 'selected' : '' %>>Failed</option>
            <option value="skipped" <%= filters?.status === 'skipped' ? 'selected' : '' %>>Skipped</option>
          </select>
        </div>
        <div class="md:col-span-4 flex gap-3">
          <button type="submit" class="btn btn-primary">Apply</button>
          <a href="/patrols" class="btn btn-secondary">Clear</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Template</th>
              <th>Site</th>
              <th>Guard</th>
              <th>Status</th>
              <th>Progress</th>
              <th>Scheduled</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!patrols || patrols.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-secondary-500">No patrol runs found</td>
              </tr>
            <% } %>
            <% (patrols || []).forEach(patrol => { %>
              <tr>
                <td>#<%= patrol.id %></td>
                <td>
                  <div class="font-medium"><%= patrol.template?.name || '-' %></div>
                  <div class="text-xs text-secondary-500"><%= patrol.template?.code || '' %></div>
                </td>
                <td>
                  <div class="font-medium"><%= patrol.site?.name || '-' %></div>
                  <div class="text-xs text-secondary-500"><%= patrol.site?.code || '' %></div>
                </td>
                <td>
                  <div><%= patrol.guard ? patrol.guard.firstName + ' ' + patrol.guard.lastName : '-' %></div>
                  <div class="text-xs text-secondary-500"><%= patrol.guard?.email || '' %></div>
                </td>
                <td><span class="badge badge-secondary"><%= patrol.status %></span></td>
                <td>
                  <div class="text-sm"><%= patrol.checkpointsCompleted %>/<%= patrol.checkpointsTotal %></div>
                  <div class="text-xs text-secondary-500"><%= patrol.completionPercentage %>%</div>
                </td>
                <td>
                  <div><%= patrol.scheduledStart ? new Date(patrol.scheduledStart).toLocaleDateString() : '-' %></div>
                  <div class="text-xs text-secondary-500"><%= patrol.scheduledStart ? new Date(patrol.scheduledStart).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '' %></div>
                </td>
                <td class="text-right"><a class="btn btn-secondary" href="/patrols/<%= patrol.id %>">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (pagination && pagination.totalPages > 1) { %>
    <div class="flex items-center justify-between text-sm text-secondary-600">
      <span>Showing <%= pagination.from %>-<%= pagination.to %> of <%= pagination.total %></span>
      <div class="flex gap-2">
        <% if (pagination.prevPage) { %>
          <a class="btn btn-secondary" href="?page=<%= pagination.prevPage %><%= filters?.search ? '&search=' + encodeURIComponent(filters.search) : '' %><%= filters?.status ? '&status=' + encodeURIComponent(filters.status) : '' %>">Prev</a>
        <% } %>
        <% if (pagination.nextPage) { %>
          <a class="btn btn-secondary" href="?page=<%= pagination.nextPage %><%= filters?.search ? '&search=' + encodeURIComponent(filters.search) : '' %><%= filters?.status ? '&status=' + encodeURIComponent(filters.status) : '' %>">Next</a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
