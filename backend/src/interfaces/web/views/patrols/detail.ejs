<div class="bg-white border-b border-secondary-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center gap-2 text-sm text-secondary-500 mb-2">
      <a href="/patrols" class="hover:text-secondary-800">Patrols</a>
      <span>/</span>
      <span class="text-secondary-900">#<%= patrol.id %></span>
    </div>
    <h1 class="text-2xl font-bold text-secondary-900">Patrol Run #<%= patrol.id %></h1>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="card">
      <div class="card-header">
        <h2 class="text-lg font-semibold text-secondary-900">Checkpoint Logs</h2>
      </div>
      <div class="card-body">
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Checkpoint</th>
                <th>Verification</th>
                <th>Valid</th>
                <th>Verified At</th>
              </tr>
            </thead>
            <tbody>
              <% if (!patrol.checkpointLogs || patrol.checkpointLogs.length === 0) { %>
                <tr><td colspan="4" class="text-center text-secondary-500">No checkpoint logs recorded</td></tr>
              <% } %>
              <% (patrol.checkpointLogs || []).forEach(log => { %>
                <tr>
                  <td>
                    <div class="font-medium"><%= log.checkpoint?.name || '-' %></div>
                    <div class="text-xs text-secondary-500"><%= log.checkpoint?.code || '' %></div>
                  </td>
                  <td><%= log.verificationType || '-' %></td>
                  <td><span class="badge <%= log.isValid ? 'badge-success' : 'badge-error' %>"><%= log.isValid ? 'Valid' : 'Invalid' %></span></td>
                  <td><%= log.verifiedAt ? new Date(log.verifiedAt).toLocaleString() : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card">
      <div class="card-body space-y-3">
        <div class="text-sm"><span class="text-secondary-500">Status:</span> <span class="font-medium"><%= patrol.status %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Template:</span> <span class="font-medium"><%= patrol.template?.name || '-' %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Site:</span> <span class="font-medium"><%= patrol.site?.name || '-' %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Guard:</span> <span class="font-medium"><%= patrol.guard ? patrol.guard.firstName + ' ' + patrol.guard.lastName : '-' %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Progress:</span> <span class="font-medium"><%= patrol.checkpointsCompleted %>/<%= patrol.checkpointsTotal %> (<%= patrol.completionPercentage %>%)</span></div>
        <div class="text-sm"><span class="text-secondary-500">Scheduled:</span> <span class="font-medium"><%= patrol.scheduledStart ? new Date(patrol.scheduledStart).toLocaleString() : '-' %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Actual Start:</span> <span class="font-medium"><%= patrol.actualStart ? new Date(patrol.actualStart).toLocaleString() : '-' %></span></div>
        <div class="text-sm"><span class="text-secondary-500">Actual End:</span> <span class="font-medium"><%= patrol.actualEnd ? new Date(patrol.actualEnd).toLocaleString() : '-' %></span></div>
      </div>
    </div>
  </div>
</div>
