<%
/**
 * Reset Password View
 *
 * Password reset form page for PatrolManager
 *
 * @param {string} token - Password reset token from URL
 * @param {string} error - Error message from previous attempt
 */
%>

<% layout = 'layouts/auth' %>
<% title = 'Reset Password - PatrolManager' %>
<% subtitle = 'Create a new password' %>

<form id="reset-password-form" class="space-y-5">
  <!-- CSRF Token -->
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="token" value="<%= token || '' %>">

  <!-- Description -->
  <div class="text-sm text-secondary-600">
    <p>Please enter your new password below. Make sure it's at least 8 characters long.</p>
  </div>

  <!-- New Password -->
  <div class="input-group">
    <label for="password" class="input-label">New password</label>
    <div class="relative">
      <input
        type="password"
        id="password"
        name="password"
        class="input pr-10"
        placeholder="Enter new password"
        required
        autocomplete="new-password"
        minlength="8">
      <button
        type="button"
        class="absolute inset-y-0 right-0 pr-3 flex items-center text-secondary-400 hover:text-secondary-600"
        onclick="togglePasswordVisibility('password')"
        aria-label="Toggle password visibility">
        <svg id="password-toggle-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
      </button>
    </div>
    <p id="password-error" class="input-error hidden"></p>
  </div>

  <!-- Password Strength Indicator -->
  <div class="space-y-2">
    <div class="flex items-center justify-between text-xs text-secondary-600">
      <span>Password strength</span>
      <span id="strength-text">Enter a password</span>
    </div>
    <div class="flex gap-1">
      <div id="strength-bar-1" class="h-1 flex-1 rounded-full bg-secondary-200 transition-colors"></div>
      <div id="strength-bar-2" class="h-1 flex-1 rounded-full bg-secondary-200 transition-colors"></div>
      <div id="strength-bar-3" class="h-1 flex-1 rounded-full bg-secondary-200 transition-colors"></div>
      <div id="strength-bar-4" class="h-1 flex-1 rounded-full bg-secondary-200 transition-colors"></div>
    </div>
  </div>

  <!-- Confirm Password -->
  <div class="input-group">
    <label for="confirmPassword" class="input-label">Confirm new password</label>
    <div class="relative">
      <input
        type="password"
        id="confirmPassword"
        name="confirmPassword"
        class="input pr-10"
        placeholder="Confirm new password"
        required
        autocomplete="new-password">
      <button
        type="button"
        class="absolute inset-y-0 right-0 pr-3 flex items-center text-secondary-400 hover:text-secondary-600"
        onclick="togglePasswordVisibility('confirmPassword')"
        aria-label="Toggle password visibility">
        <svg id="confirmPassword-toggle-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
      </button>
    </div>
    <p id="confirm-error" class="input-error hidden"></p>
  </div>

  <!-- Password Requirements -->
  <div class="bg-secondary-50 rounded-lg p-4">
    <p class="text-xs font-medium text-secondary-700 mb-2">Password must contain:</p>
    <ul class="space-y-1">
      <li id="req-length" class="flex items-center gap-2 text-xs text-secondary-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2" class="stroke-current"/>
        </svg>
        At least 8 characters
      </li>
      <li id="req-uppercase" class="flex items-center gap-2 text-xs text-secondary-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2" class="stroke-current"/>
        </svg>
        At least one uppercase letter
      </li>
      <li id="req-lowercase" class="flex items-center gap-2 text-xs text-secondary-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2" class="stroke-current"/>
        </svg>
        At least one lowercase letter
      </li>
      <li id="req-number" class="flex items-center gap-2 text-xs text-secondary-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2" class="stroke-current"/>
        </svg>
        At least one number
      </li>
    </ul>
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    id="submit-btn"
    class="w-full btn btn-primary py-3 text-base">
    <span id="btn-text">Reset Password</span>
    <svg id="btn-spinner" class="spinner-md hidden" fill="currentColor" viewBox="0 0 20 20">
      <circle class="opacity-25" cx="10" cy="10" r="8" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  </button>
</form>

<!-- Success message (hidden by default) -->
<div id="success-message" class="hidden text-center py-6">
  <div class="inline-flex items-center justify-center w-16 h-16 bg-success-100 rounded-full mb-4">
    <svg class="w-8 h-8 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-secondary-900 mb-2">Password reset successful</h3>
  <p class="text-sm text-secondary-600 mb-6">
    Your password has been successfully reset. You can now sign in with your new password.
  </p>
  <a href="/login" class="inline-flex btn btn-primary">
    Continue to Sign In
  </a>
</div>

<!-- Back to login -->
<p class="text-center text-sm text-secondary-500 mt-6">
  Remember your password?
  <a href="/login" class="text-primary-600 hover:text-primary-700 font-medium">Sign in</a>
</p>

<style>
  .input-error {
    display: block;
  }
</style>

<% blocks.scripts = `
<script>
  const form = document.getElementById('reset-password-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const successMessage = document.getElementById('success-message');
  const passwordInput = document.getElementById('password');
  const confirmInput = document.getElementById('confirmPassword');
  const passwordError = document.getElementById('password-error');
  const confirmError = document.getElementById('confirm-error');

  function setLoading(loading) {
    submitBtn.disabled = loading;
    if (loading) {
      btnText.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
    } else {
      btnText.classList.remove('hidden');
      btnSpinner.classList.add('hidden');
    }
  }

  function showPasswordError(message) {
    passwordInput.classList.add('border-error-500', 'focus:ring-error-500', 'focus:border-error-500');
    passwordInput.classList.remove('border-secondary-300', 'focus:ring-primary-500', 'focus:border-primary-500');
    passwordError.textContent = message;
    passwordError.classList.remove('hidden');
  }

  function showConfirmError(message) {
    confirmInput.classList.add('border-error-500', 'focus:ring-error-500', 'focus:border-error-500');
    confirmInput.classList.remove('border-secondary-300', 'focus:ring-primary-500', 'focus:border-primary-500');
    confirmError.textContent = message;
    confirmError.classList.remove('hidden');
  }

  function clearErrors() {
    passwordInput.classList.remove('border-error-500', 'focus:ring-error-500', 'focus:border-error-500');
    passwordInput.classList.add('border-secondary-300', 'focus:ring-primary-500', 'focus:border-primary-500');
    passwordError.classList.add('hidden');

    confirmInput.classList.remove('border-error-500', 'focus:ring-error-500', 'focus:border-error-500');
    confirmInput.classList.add('border-secondary-300', 'focus:ring-primary-500', 'focus:border-primary-500');
    confirmError.classList.add('hidden');
  }

  // Password strength checker
  function checkPasswordStrength(password) {
    let strength = 0;
    const checks = {
      length: password.length >= 8,
      uppercase: /[A-Z]/.test(password),
      lowercase: /[a-z]/.test(password),
      number: /[0-9]/.test(password)
    };

    // Update requirement icons
    updateRequirement('req-length', checks.length);
    updateRequirement('req-uppercase', checks.uppercase);
    updateRequirement('req-lowercase', checks.lowercase);
    updateRequirement('req-number', checks.number);

    strength = Object.values(checks).filter(Boolean).length;
    updateStrengthIndicator(strength);
  }

  function updateRequirement(id, met) {
    const el = document.getElementById(id);
    const svg = el.querySelector('svg');
    if (met) {
      el.classList.remove('text-secondary-600');
      el.classList.add('text-success-600');
      svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>';
    } else {
      el.classList.remove('text-success-600');
      el.classList.add('text-secondary-600');
      svg.innerHTML = '<circle cx="12" cy="12" r="10" stroke-width="2" class="stroke-current"/>';
    }
  }

  function updateStrengthIndicator(strength) {
    const bars = [
      document.getElementById('strength-bar-1'),
      document.getElementById('strength-bar-2'),
      document.getElementById('strength-bar-3'),
      document.getElementById('strength-bar-4')
    ];
    const text = document.getElementById('strength-text');

    const colors = ['bg-error-500', 'bg-warning-500', 'bg-warning-500', 'bg-success-500'];
    const labels = ['Weak', 'Fair', 'Good', 'Strong'];

    bars.forEach((bar, index) => {
      bar.className = 'h-1 flex-1 rounded-full transition-colors';
      if (index < strength) {
        bar.classList.add(colors[strength - 1]);
      } else {
        bar.classList.add('bg-secondary-200');
      }
    });

    if (strength === 0) {
      text.textContent = 'Enter a password';
    } else {
      text.textContent = labels[strength - 1];
      text.className = 'text-xs font-medium ' + (strength >= 3 ? 'text-success-600' : strength === 2 ? 'text-warning-600' : 'text-error-600');
    }
  }

  passwordInput.addEventListener('input', () => {
    checkPasswordStrength(passwordInput.value);
    clearErrors();
  });

  confirmInput.addEventListener('input', clearErrors);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const password = passwordInput.value;
    const confirmPassword = confirmInput.value;
    const token = document.querySelector('input[name="token"]').value;

    // Validation
    if (password.length < 8) {
      showPasswordError('Password must be at least 8 characters long');
      return;
    }

    if (password !== confirmPassword) {
      showConfirmError('Passwords do not match');
      return;
    }

    const strength = calculateStrength(password);
    if (strength < 2) {
      showPasswordError('Password is too weak. Please add more characters, numbers, or symbols.');
      return;
    }

    setLoading(true);

    try {
      const response = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('input[name="_csrf"]').value
        },
        body: JSON.stringify({ token, password })
      });

      const data = await response.json();

      if (response.ok) {
        form.classList.add('hidden');
        successMessage.classList.remove('hidden');
      } else {
        showPasswordError(data.error?.message || 'Failed to reset password. The link may have expired.');
      }
    } catch (error) {
      showPasswordError('Network error. Please check your connection and try again.');
    } finally {
      setLoading(false);
    }
  });

  function calculateStrength(password) {
    let strength = 0;
    if (password.length >= 8) strength++;
    if (password.length >= 12) strength++;
    if (/[A-Z]/.test(password)) strength++;
    if (/[a-z]/.test(password)) strength++;
    if (/[0-9]/.test(password)) strength++;
    if (/[^A-Za-z0-9]/.test(password)) strength++;
    return Math.min(strength, 4);
  }

  function togglePasswordVisibility(inputId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(inputId + '-toggle-icon');

    if (input.type === 'password') {
      input.type = 'text';
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
    } else {
      input.type = 'password';
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
    }
  }
</script>
`; %>
