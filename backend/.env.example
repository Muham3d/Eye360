# =============================================================================
# PatrolManager Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patrolmanager
DB_USER=patrolmanager
DB_PASSWORD=change_me_in_production
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=true

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT Secret for Mobile API Authentication (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session Secret for Admin Web Panel
SESSION_SECRET=your_session_secret_change_this_in_production

# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# WebSocket Configuration (Socket.io)
# -----------------------------------------------------------------------------
WS_ENABLED=true
WS_PATH=/socket.io/
WS_CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Base URL for the admin web panel
WEB_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
# Max file size for incident evidence uploads (in bytes)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------
# SMTP settings for sending notifications and reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@patrolmanager.com

# -----------------------------------------------------------------------------
# SMS Configuration (Optional - for SOS alerts)
# -----------------------------------------------------------------------------
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log levels: error, warn, info, debug
LOG_LEVEL=info
LOG_FILE_PATH=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# -----------------------------------------------------------------------------
# Geolocation Configuration
# -----------------------------------------------------------------------------
# Default GPS accuracy threshold in meters
GPS_ACCURACY_THRESHOLD=50

# Maximum age of GPS position in milliseconds
GPS_MAX_AGE=30000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Rate limit for API endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# API Documentation
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_TITLE=PatrolManager API
SWAGGER_DESCRIPTION=Security Guard Management System API
SWAGGER_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Development/Debug Flags
# -----------------------------------------------------------------------------
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_SWAGGER=true
