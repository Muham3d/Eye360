# =============================================================================
# PatrolManager Staging Environment Configuration
# =============================================================================
#
# Staging environment for pre-production testing.
# All secrets should be stored in AWS Secrets Manager.
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=staging

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
SERVER_HOST=0.0.0.0
API_URL=https://staging-api.patrolmanager.com

# -----------------------------------------------------------------------------
# Database Configuration (AWS RDS PostgreSQL - Staging)
# -----------------------------------------------------------------------------
DB_HOST=${aws:secretsmanager:us-east-1:patrolmanager/staging:db_host}
DB_PORT=5432
DB_NAME=${aws:secretsmanager:us-east-1:patrolmanager/staging:db_name}
DB_USER=${aws:secretsmanager:us-east-1:patrolmanager/staging:db_user}
DB_PASSWORD=${aws:secretsmanager:us-east-1:patrolmanager/staging:db_password}
DB_SSL=true
DB_URL=postgresql://${aws:secretsmanager:us-east-1:patrolmanager/staging:db_user}:${aws:secretsmanager:us-east-1:patrolmanager/staging:db_password}@${aws:secretsmanager:us-east-1:patrolmanager/staging:db_host}:5432/${aws:secretsmanager:us-east-1:patrolmanager/staging:db_name}

# Read Replicas (staging may use single replica)
DB_READ_REPLICA_1=${aws:secretsmanager:us-east-1:patrolmanager/staging:db_read_replica_1}

# Connection Pool Settings (Staging - smaller than production)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=10000
DB_POOL_EVICT=60000

# -----------------------------------------------------------------------------
# JWT Configuration (Mobile API Authentication)
# -----------------------------------------------------------------------------
JWT_SECRET=${aws:secretsmanager:us-east-1:patrolmanager/staging:jwt_secret}
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=patrolmanager-staging
JWT_AUDIENCE=patrolmanager-api-staging

# -----------------------------------------------------------------------------
# Session Configuration (Admin Web Panel)
# -----------------------------------------------------------------------------
SESSION_SECRET=${aws:secretsmanager:us-east-1:patrolmanager/staging:session_secret}
SESSION_COOKIE_MAX_AGE=86400000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# CORS Configuration (more permissive for staging)
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://staging-admin.patrolmanager.com,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting (more permissive for testing)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# -----------------------------------------------------------------------------
# Logging & Monitoring (verbose for staging)
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_CLOUDWATCH_ENABLED=true
LOG_CLOUDWATCH_GROUP=/aws/ecs/patrolmanager
LOG_CLOUDWATCH_STREAM=staging
LOG_PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:patrolmanager/staging-*
AWS_S3_BUCKET=patrolmanager-evidence-staging
AWS_ECR_REPOSITORY=patrolmanager-backend

# -----------------------------------------------------------------------------
# File Upload (S3 Storage)
# -----------------------------------------------------------------------------
STORAGE_TYPE=s3
S3_BUCKET=patrolmanager-evidence-staging
S3_REGION=us-east-1
S3_ACL=private
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/webm

# -----------------------------------------------------------------------------
# Socket.io Configuration
# -----------------------------------------------------------------------------
SOCKET_IO_PORT=3000
SOCKET_IO_PATH=/socket.io
SOCKET_IO_PING_TIMEOUT=30000
SOCKET_IO_PING_INTERVAL=25000

# -----------------------------------------------------------------------------
# Geofencing & GPS Configuration
# -----------------------------------------------------------------------------
GPS_UPDATE_INTERVAL=5000
GPS_MAX_DEVIATION=100
GEOFENCE_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# Notification Configuration
# -----------------------------------------------------------------------------
# FCM for Android (staging project)
PUSH_NOTIFICATION_SERVICE=fcm
FCM_PROJECT_ID=${aws:secretsmanager:us-east-1:patrolmanager/staging:fcm_project_id}
FCM_PRIVATE_KEY=${aws:secretsmanager:us-east-1:patrolmanager/staging:fcm_private_key}
FCM_CLIENT_EMAIL=${aws:secretsmanager:us-east-1:patrolmanager/staging:fcm_client_email}

# Email notifications (AWS SES - sandbox mode)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=${aws:secretsmanager:us-east-1:patrolmanager/staging:smtp_user}
SMTP_PASSWORD=${aws:secretsmanager:us-east-1:patrolmanager/staging:smtp_password}
SMTP_FROM=noreply@staging.patrolmanager.com

# -----------------------------------------------------------------------------
# External Integrations
# -----------------------------------------------------------------------------
# Twilio for SMS (test credentials)
TWILIO_ACCOUNT_SID=${aws:secretsmanager:us-east-1:patrolmanager/staging:twilio_account_sid}
TWILIO_AUTH_TOKEN=${aws:secretsmanager:us-east-1:patrolmanager/staging:twilio_auth_token}
TWILIO_PHONE_NUMBER=${aws:secretsmanager:us-east-1:patrolmanager/staging:twilio_phone}

# Map service (staging API key)
MAPS_API_KEY=${aws:secretsmanager:us-east-1:patrolmanager/staging:maps_api_key}
MAPS_PROVIDER=google

# Sentry Error Tracking (staging environment)
SENTRY_DSN=${aws:secretsmanager:us-east-1:patrolmanager/staging:sentry_dsn}
SENTRY_ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Feature Flags (all features enabled for testing)
# -----------------------------------------------------------------------------
FEATURE_OFFLINE_SYNC=true
FEATURE_SOS_ALERTS=true
FEATURE_PTT_ENABLED=true
FEATURE_INCIDENT_ESCALATION=true
FEATURE_PATROL_AUTO_ASSIGNMENT=true
FEATURE_REAL_TIME_TRACKING=true
FEATURE_ANALYTICS_DASHBOARD=true

# -----------------------------------------------------------------------------
# Backup & Maintenance
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=patrolmanager-backups-staging
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
HELMET_ENABLED=true
CSP_ENABLED=true
RATE_LIMIT_AUTH_ENABLED=true
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW=60000
