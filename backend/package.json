{
  "name": "@patrolmanager/backend",
  "version": "1.0.0",
  "description": "PatrolManager Backend API & Admin Web Panel",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "build:css": "tailwindcss -i ./src/interfaces/web/public/assets/css/main.css -o ./src/interfaces/web/public/assets/css/dist.css --minify",
    "build:css:dev": "tailwindcss -i ./src/interfaces/web/public/assets/css/main.css -o ./src/interfaces/web/public/assets/css/dist.css",
    "watch:css": "tailwindcss -i ./src/interfaces/web/public/assets/css/main.css -o ./src/interfaces/web/public/assets/css/dist.css --watch",
    "start": "node --experimental-modules dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "format:check": "prettier --check 'src/**/*.{js,ts,json,md}'",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:seed:dev": "sequelize-cli db:seed --seeders-path src/infrastructure/database/seeders/20240224000001-seed-development-users.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "db:test:connection": "node -e \"import('./src/infrastructure/config/database.js').then(m => m.testConnection())\"",
    "prepare": "husky install"
  },
  "keywords": [
    "patrol",
    "security",
    "guard-management",
    "geofencing"
  ],
  "author": "PatrolManager Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.450.0",
    "@aws-sdk/client-secrets-manager": "^3.450.0",
    "autoprefixer": "^10.4.17",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "connect-session-sequelize": "^7.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.9",
    "express": "^4.19.0",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "postcss": "^8.4.35",
    "prom-client": "^15.0.0",
    "sequelize": "^6.37.0",
    "socket.io": "^4.7.0",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^7.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
